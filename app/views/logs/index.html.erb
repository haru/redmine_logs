<% if @error -%>
  <div class="flash error"><%= @error -%></div>
<% end -%>

<h2><%= l(:logs) %></h2>

<% if @view_mode == 'tabs' %>
  <%
    tabs = LogsController::CATEGORIES.map do |cat|
      count = (@categorized_logs[cat[:id]] || []).size
      {
        name: cat[:id],
        label: "#{l(cat[:name])} (#{count})",
        partial: 'logs/tab_content'
      }
    end
  %>

  <div class="tabs">
    <ul>
      <% tabs.each do |tab| %>
        <li>
          <%= link_to tab[:label], { tab: tab[:name] }, id: "tab-#{tab[:name]}", class: (tab[:name] == @selected_tab ? 'selected' : nil) %>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="tab-content" id="tab-content-<%= @selected_tab %>">
    <%= render partial: 'logs/log_table', locals: { logs: @categorized_logs[@selected_tab] || [] } %>
  </div>

<% elsif @view_mode == 'flat' %>
  <%= render partial: 'logs/log_table', locals: { logs: @logs } %>

<% else %>
  <%# Default: Grouped Headings with Tables %>
  <% LogsController::CATEGORIES.each do |cat| %>
    <% cat_logs = @categorized_logs[cat[:id]] || [] %>
    <h3>
      <%= l(cat[:name]) %>
      <span class="count">(<%= cat_logs.size %>)</span>
    </h3>
    <%= render partial: 'logs/log_table', locals: { logs: cat_logs } %>
  <% end %>
<% end %>
